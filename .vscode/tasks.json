{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with PyInstaller",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "workon ordraft && pyinstaller --onefile main.py --clean --noconfirm --add-data \"resource;resource\" --add-data \"resource/icons;resource/icons\" --hidden-import pkgs --name OrDraft --icon resource/icon.ico"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}